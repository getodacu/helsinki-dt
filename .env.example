# Copy to .env beside package.json. No upstream credentials are required.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
# Graceful SIGTERM/SIGINT timeout, in seconds.
SHUTDOWN_TIMEOUT=30
# Behind a trusted reverse proxy that replaces this header, uncomment:
# PROTOCOL_HEADER=x-forwarded-proto

# Optional persistent disk directory used by the app and city:cache command.
# One process owns it: stop the app before CLI writes to the same directory.
# Use separate directories for concurrent workers; preserve across deployments.
# Default: .cache/city-map
# CITY_MAP_CACHE_DIR=/var/lib/helsinki-lens/city-map
# Municipal metadata + binary budget; excludes temporary and photo/sibling dirs.
# Positive safe integers only; invalid values use defaults. Calibrate for host.
# Bytes: 8589934592 = 8 GiB. Entries count municipal assets, not individual files.
CITY_MAP_CACHE_MAX_BYTES=8589934592
CITY_MAP_CACHE_MAX_ENTRIES=16384
# Distinct pending requests (active + queued), and queued requests.
CITY_MAP_CACHE_MAX_PENDING=36
CITY_MAP_CACHE_MAX_QUEUED=32
