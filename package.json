{
  "name": "helsinki-lens",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/check-requirements.mjs --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node --import ./scripts/check-requirements.mjs node_modules/vite/bin/vite.js build",
    "start": "node --import ./scripts/check-requirements.mjs --env-file-if-exists=.env build/index.js",
    "preview": "node --import ./scripts/check-requirements.mjs --env-file-if-exists=.env node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "check": "node scripts/check-requirements.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/check-requirements.mjs && node --test tests/*.test.ts",
    "data:prepare": "node --import ./scripts/check-requirements.mjs scripts/prepare-data.ts",
    "data:probe": "node --import ./scripts/check-requirements.mjs scripts/probe-data.ts",
    "city:cache": "node --import ./scripts/check-requirements.mjs --env-file-if-exists=.env scripts/cache-city-map.ts",
    "city:prepare": "node --import ./scripts/check-requirements.mjs scripts/prepare-city.ts",
    "routes:prepare": "node --import ./scripts/check-requirements.mjs scripts/prepare-routes.ts",
    "rail:prepare": "node --import ./scripts/check-requirements.mjs scripts/prepare-rail.ts",
    "ryhti:prepare": "node --import ./scripts/check-requirements.mjs scripts/prepare-ryhti.ts",
    "energy:prepare": "node --import ./scripts/check-requirements.mjs scripts/prepare-energy.ts",
    "release:package": "node --import ./scripts/check-requirements.mjs scripts/package-release.ts",
    "entities:prepare": "node --import ./scripts/check-requirements.mjs scripts/prepare-entities.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.0",
    "@tanstack/svelte-query": "6.3.1",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "geotiff": "3.0.5",
    "mqtt": "5.16.0",
    "proj4": "2.22.0",
    "svelte": "5.57.1",
    "three": "0.186.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "@types/yauzl": "2.10.3",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
